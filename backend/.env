# Copy this file to .env and fill in your values
# Never commit the real .env to git

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://buddy:buddy@localhost:5432/businessbuddy

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER=groq to use Groq's free tier instead of Anthropic
# Get a free Groq API key at: https://console.groq.com
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=sk-ant-...

# Groq (free tier — set LLM_PROVIDER=groq above to activate)
GROQ_API_KEY=gsk_
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile   # default
# GROQ_DOC_MODEL=llama-3.1-8b-instant       # default

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── Documents ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/business_buddy_uploads
MAX_UPLOAD_MB=50

# ── Stripe (Phase 3 — leave blank to disable billing UI) ─────────────────────
# 1. Create account at https://stripe.com
# 2. Get keys from https://dashboard.stripe.com/apikeys
# 3. Create two products (Pro + Business) and copy the price IDs
# 4. Set webhook endpoint to https://yourdomain.com/billing/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ── SMTP — for invite emails (leave blank to log to console instead) ──────────
# Gmail: enable 2FA then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=buddy@yourdomain.com
